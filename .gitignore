# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# Official data and generated numeric caches
data/raw/dataset/
data/raw/*.zip
data/processed/

# Large or reproducible model artifacts
results/boosting_artifacts/
results/mlp_artifacts/
results/oof_predictions/
results/reproduction/
results/experiments/*_oof_predictions.npz
results/linear_imputation_artifacts/**/*.npz
*.pkl
*.pkl.tmp

# Keep the text codebook required by the parser tests, but exclude all other
# course material (PDFs, copied grading tests, and generated caches).
official_material/*
!official_material/project1/
official_material/project1/*
!official_material/project1/brfss_2015_codebook.txt

# Generated submissions and local logs
submission*.csv
*.log

# Temporary test directories
tests/tmp*/
pytest-cache-files-*/
results/phase35_smoke_*/
# Tests of optional local scheduling helpers are kept with the local runs.
tests/test_count_ab_parallel_tail.py
tests/test_tuning_parallel_tail.py

# Delivery work directories contain local paths and duplicated generated output.
# Publish only the dated aggregate AIcrowd feedback; portable summaries live in eda/.
results/aicrowd_*/*
!results/aicrowd_*/reported_aicrowd_scores.json
!results/aicrowd_*/aicrowd_feedback_20261013.json
!results/aicrowd_*/verification.json

# LaTeX build intermediates (the report source and PDF are versioned).
*.aux
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# Editors and operating systems
.local/
.idea/
.vscode/
.DS_Store
Thumbs.db
